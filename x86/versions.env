# Pinned inputs of the x86 VM image (read by build.sh and the "Build OpenWrt" workflow).
# Change what gets built only here, in a commit: every release then maps to exactly one commit.
OPENWRT_VERSION=25.12.6
# upstream sing-box release and the sha256 of its sing-box_<version>_openwrt_x86_64.ipk (update together)
SINGBOX_TAG=v1.14.3
