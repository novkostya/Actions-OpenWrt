# github.com/Slava-Shchipunov/awg-openwrt release for this OpenWrt version; sha256 of the
# kmod-amneziawg and amneziawg-tools packages for x86/64 (update together with the version)
AWG_TAG=v25.12.6
AWG_KMOD_SHA256=641246b68ebe740360602916d0d6301ff85c7a6f9804aeb290323b016d82c977
AWG_TOOLS_SHA256=2dbe5a742df33fdf06064c9f3df5c01b50457c47f2030be57066aa93eb988eb3
