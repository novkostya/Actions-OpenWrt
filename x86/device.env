# x86-64 router VM on Proxmox: what build.sh builds (versions and checksums are in versions.env)
TARGET=x86/64
PROFILE=generic
# package architecture, also in the names of the awg-openwrt and upstream sing-box release assets
ARCH_PACKAGES=x86_64
# rootfs partition size in MB
ROOTFS_PARTSIZE=256
# sing-box: the upstream release build (all features), no SINGBOX_BUILD_TAGS
