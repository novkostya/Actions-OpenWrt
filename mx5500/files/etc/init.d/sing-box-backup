#!/bin/sh /etc/rc.common
# Backup Hysteria2 Realms inbound (realm dxb-hy2-backup) for asf's Dubai exits.
# Never started at boot: keepalived starts it while this AP holds 192.168.21.1 (/etc/keepalived/notify.sh).
# No START/STOP on purpose, so neither ImageBuilder nor `enable` can add rc.d links for it.

USE_PROCD=1

start_service() {
	mkdir -p /tmp/sing-box-backup
	procd_open_instance
	procd_set_param command /usr/bin/sing-box run -c /etc/sing-box-backup/config.json -D /tmp/sing-box-backup
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
