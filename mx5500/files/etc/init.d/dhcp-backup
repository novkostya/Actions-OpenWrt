#!/bin/sh /etc/rc.common
# Backup DHCP for the dxb LAN and guest Wi-Fi: a DHCP-only dnsmasq (port=0) next to the main one.
# Never started at boot: keepalived starts it while this AP holds 192.168.21.1 (/etc/keepalived/notify.sh).
# Config /etc/dhcp-backup/dnsmasq.conf is generated from VM 100's dnsmasq (ops: regen-mx5500-backup.sh).
# No START/STOP on purpose, so neither ImageBuilder nor `enable` can add rc.d links for it.

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dnsmasq -k -C /etc/dhcp-backup/dnsmasq.conf
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
